/Notes/

# Process records kept local only (task ledger, role handoffs)
/tasks/
/handoff/

# Local agent tooling (installed skills and lock file)
/.agents/
/skills-lock.json

# Local tool hooks (Java modernization assistant)
/.github/modernize/
